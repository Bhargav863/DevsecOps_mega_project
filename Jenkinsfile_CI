pipeline {
    agent any
    
    tools {
        nodejs 'nodejs23'
    }
    
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'docker-deploy', url: 'https://github.com/Bhargav863/DevsecOps_mega_project.git'
            }
        }
        
        stage('Frontend-compilation') {
            steps {
                dir('client') {
                         sh 'find . -name "*.js" -exec node --check {} +'
                }
            }
        }
        
        stage('Backend-compilation') {
            steps {
                dir('api') {
                         sh 'find . -name "*.js" -exec node --check {} +'
                }
            }
        }
        
        stage('Gitleaks-scan') {
            steps {
                sh ' gitleaks detect --source ./client --exit-code 1'
                sh ' gitleaks detect --source ./api --exit-code 1'
            }
        }
        
        stage('Sonarqube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                        sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=nodejs-project \
                        -Dsonar.projectKey=nodejs-project '''
                  }
            }
        }
        
        stage('Quality-Gate check') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }
        
        stage('trivy fs scan') {
            steps {
                sh 'trivy fs --format table -o fs-report.html .'
            }
        }
        
        stage('Build tag and push backend docker image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'Docker-cred') {
                       dir('api') {
                          sh 'docker build -t bhargav863/backend:latest .'
                          sh 'trivy image --format table -o backend-image-report.html bhargav863/backend:latest '
                          sh ' docker push bhargav863/backend:latest'
                       }
                   }
                }
            }
        }
        
        stage('Build and push fronetend image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'Docker-cred') {
                      dir('client') {
                          sh 'docker build -t bhargav863/frontend:latest .'
                          sh 'trivy image --format table -o frontend-image-report.html bhargav863/frontend:latest'
                          sh 'docker push bhargav863/frontend:latest'
                      }
                   }
                }
            }
        }
        
        stage('Docker deploy via compose') {
            steps {
                sh 'docker compose up -d'
            }
        }
    }
}
